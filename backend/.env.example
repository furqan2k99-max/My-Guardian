# MyGuardian backend — environment configuration

# Update these values to match your local PostgreSQL setup.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myguardian?schema=public"
PORT=4000

# JWT signing secret — use a long random value in any shared/production environment.
JWT_SECRET="dev-only-change-me-0123456789abcdef"
# Access-token lifetime (access tokens for authenticated requests).
ACCESS_TOKEN_TTL="24h"
# Family-link invite code lifetime (minutes). Short so stale codes don't linger;
# regenerated by the guardian if it expires.
INVITE_CODE_TTL_MINUTES="15"

# Logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"
# Comma-separated list of allowed origins. "*" allows any origin (dev).
CORS_ORIGINS="*"
# Per-IP rate limit window and max requests for /api/v1 endpoints.
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"
# How long evaluated identifiers stay cached in reputation_cache (seconds).
REPUTATION_TTL_SECONDS="3600"
# Google Safe Browsing API key. Leave empty to run URL-scanning in degraded
# "unknown" mode (no vendor calls) — handy for local dev / CI.
SAFE_BROWSING_API_KEY=""
# Firebase service account for FCM push (JSON string or path to the JSON file
# downloaded from Firebase console). Empty = push is skipped but otherwise
# harmless — the guardians feed still records notifications.
FCM_SERVICE_ACCOUNT_JSON=""