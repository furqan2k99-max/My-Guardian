# Base URL of the MyGuardian backend (no trailing slash).
#   iOS simulator / web: http://localhost:4000
#   Android emulator:    http://10.0.2.2:4000
#   Physical device via Expo Go: http://<your-LAN-IP>:4000
#
# Copy to .env and adjust for your environment. Values are inlined at bundle
# time (EXPO_PUBLIC_* is visible to anyone running the app — never put
# secrets here).
EXPO_PUBLIC_API_URL=http://localhost:4000